          "localized": true
        }
      }
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.hero-slider",
        "sections.services",
        "sections.about",
        "sections.capabilities",
        "sections.projects",
        "sections.news",
        "sections.cta",
        "sections.partners",
        "sections.quote-form"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
