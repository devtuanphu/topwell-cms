      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.cta-bar",
        "sections.gallery",
        "sections.page-hero",
        "sections.services",
        "sections.testimonials",
        "sections.video-cta"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
